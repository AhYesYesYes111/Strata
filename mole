#!/bin/bash
# Start the platform CLI with its own install, command and library paths.
case "$(uname -s)" in
    Darwin) _strata_platform=macos ;;
    Linux)  _strata_platform=linux ;;
    *) echo "Use components/Mole/windows/mole.ps1 on Windows." >&2; exit 1 ;;
esac
_strata_entry="${BASH_SOURCE[0]}"
while [[ -L "$_strata_entry" ]]; do
    _strata_target="$(readlink "$_strata_entry")" || exit 1
    case "$_strata_target" in
        /*) _strata_entry="$_strata_target" ;;
        *)  _strata_entry="$(dirname "$_strata_entry")/$_strata_target" ;;
    esac
done
_strata_dir="$(cd -P "$(dirname "$_strata_entry")" && pwd)" || exit 1
_strata_cli="$_strata_dir/components/Mole/$_strata_platform/mole"
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    exec "$_strata_cli" "$@"
fi
source "$_strata_cli" "$@"
